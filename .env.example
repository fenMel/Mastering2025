# ============================================================
# Supabase – Configuration
# Copier ce fichier en .env.local et renseigner vos valeurs
# ============================================================

# URL du projet Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique anon (Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-ici

# (Optionnel – côté serveur uniquement, NE PAS exposer côté client)
# Clé service_role (Settings > API > Project API keys > service_role)
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-ici
